# fleet-log-scan webhook (optional). Copy to webhook.env next to this file and chmod 600.
# The webhook stays disabled while webhook.env is missing or has no WEBHOOK_URL.
# Values are never printed, logged or stored by the tool.
WEBHOOK_URL=https://example.invalid/fleet-scan
# Sent verbatim as the Authorization header value (optional):
WEBHOOK_AUTH_HEADER=Bearer <secret>
# Optional, seconds, 1..10 (default 10):
# WEBHOOK_TIMEOUT=10
